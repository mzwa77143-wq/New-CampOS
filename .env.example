# ==========================================
# CampOS Environment Configuration Template
# ==========================================

# Google Gemini Multimodal Vision API Key
# ----------------------------------------------------
# 1. Obtain key from https://aistudio.google.com/app/apikey
# 2. For local development: copy this file to .env.local and populate your key
# 3. For GitHub CI/CD & Deployments: Add as a GitHub Repository Secret:
#    Repo Settings -> Secrets and variables -> Actions -> "New repository secret"
#    Name: GEMINI_API_KEY
#    Secret: <your_api_key>
GEMINI_API_KEY=your_gemini_api_key_here

# Qdrant Vector Database (Optional)
# ----------------------------------------------------
# If unconfigured, CampOS automatically runs its high-performance
# embedded 384-dimensional in-memory vector cosine similarity engine.
# Set these when connecting to remote Qdrant Cloud cluster.
QDRANT_URL=
QDRANT_API_KEY=

# Supabase Relational Database (Optional)
# ----------------------------------------------------
# If unconfigured, CampOS runs in resilient Local-First mode
# persisting fight camp sessions offline to browser and memory.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
